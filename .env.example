# ---- Backend / server-only (set these in Vercel Project Settings → Environment Variables) ----
# Your own Supabase project URL.
SUPABASE_URL=https://your-project.supabase.co

# Supabase service role key — server only, NEVER expose to the browser.
# Find it in Supabase Dashboard → Project Settings → API → service_role secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
